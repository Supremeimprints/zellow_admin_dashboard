# Disable directory listings
Options -Indexes

ErrorDocument 404 /zellow_admin/404.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /zellow_admin/

    # Handle direct access to product images
    RewriteCond %{REQUEST_URI} ^/zellow_admin/uploads/products/
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Handle API image requests
    RewriteRule ^api/products/image$ api/products/serve_image.php [L,QSA]

    # Handle API requests
    RewriteCond %{REQUEST_URI} ^/zellow_admin/api/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^api/(.*)$ api/index.php [QSA,L]

    # Set CORS headers for API requests
    <IfModule mod_headers.c>
        Header set Access-Control-Allow-Origin "*"
        Header set Access-Control-Allow-Methods "GET, POST, OPTIONS, PUT, DELETE"
        Header set Access-Control-Allow-Headers "Content-Type, Access-Control-Allow-Headers, Authorization, X-Requested-With"
    </IfModule>

    # Handle CORS preflight requests
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ $1 [R=200,L]

    # Protect sensitive directories
    RewriteRule ^(config|includes)/ - [F,L]

    # Handle other routes
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
